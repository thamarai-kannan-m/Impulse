<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up / transfer the local database and settings (no cloud account needed). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="lifeloop.db" />
        <include domain="file" path="datastore/lifeloop_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="lifeloop.db" />
        <include domain="file" path="datastore/lifeloop_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
